RewriteEngine On
RewriteBase /RVA/school_management/

# Disable directory browsing
Options -Indexes

# If it's a real file or directory, serve it directly (e.g. assets, uploads)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# For paths with module and action: e.g. /admin/students
RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.php?module=$1&action=$2 [QSA,L]

# For paths with just module: e.g. /admin
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?module=$1&action=index [QSA,L]
